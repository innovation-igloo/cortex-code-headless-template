# ---------------------------------------------------------------------------
# Example environment for local development.
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# How the service authenticates to Snowflake.
#   dev        -> named connection from ~/.snowflake/config.toml (local dev)
#   pat        -> env-var connection using a PAT (SNOWFLAKE_CONNECTIONS_<NAME>_*),
#                 injected via a Snowflake Secret in SPCS. Recommended for SPCS.
#   spcs_oauth -> bridge the SPCS-injected OAuth token at /snowflake/session/token
HEADLESS_AGENT_AUTH_MODE=dev

# Connection name the CLI selects. dev: must exist in your config.toml.
# pat: must match the SNOWFLAKE_CONNECTIONS_<NAME>_* env vars below.
HEADLESS_AGENT_CONNECTION=my-connection

# --- pat mode only: env-var connection (uppercase the connection name) ---
# SNOWFLAKE_CONNECTIONS_MY_CONNECTION_ACCOUNT=myorg-myacct
# SNOWFLAKE_CONNECTIONS_MY_CONNECTION_USER=svc_user
# SNOWFLAKE_CONNECTIONS_MY_CONNECTION_ROLE=MY_ROLE
# SNOWFLAKE_CONNECTIONS_MY_CONNECTION_WAREHOUSE=MY_WH
# SNOWFLAKE_CONNECTIONS_MY_CONNECTION_AUTHENTICATOR=programmatic_access_token
# SNOWFLAKE_CONNECTIONS_MY_CONNECTION_PASSWORD=<PAT>   # in SPCS, from a Snowflake Secret

# Model for the agent. "auto" lets Cortex pick the best available model.
HEADLESS_AGENT_MODEL=auto

# HTTP server bind address / port.
HEADLESS_AGENT_HOST=0.0.0.0
HEADLESS_AGENT_PORT=8000

# Comma-separated tools that are auto-approved without a permission callback.
# The built-in Snowflake query tool is literally named "SQL".
# Leave empty to route every tool call through the can_use_tool policy.
HEADLESS_AGENT_ALLOWED_TOOLS=SQL,Read,Grep,Glob

# Comma-separated tools that are always denied (takes precedence over allow).
HEADLESS_AGENT_DISALLOWED_TOOLS=

# Permission mode: default | plan | acceptEdits | bypassPermissions
# bypassPermissions also requires HEADLESS_AGENT_ALLOW_BYPASS=true.
HEADLESS_AGENT_PERMISSION_MODE=default
HEADLESS_AGENT_ALLOW_BYPASS=false

# Optional: override the system prompt the agent runs with.
# HEADLESS_AGENT_SYSTEM_PROMPT=You are a data engineering copilot for ACME.

# Working directory the agent's file tools operate in (inside the container).
HEADLESS_AGENT_WORKDIR=/workspace

# Logging: DEBUG | INFO | WARNING | ERROR
HEADLESS_AGENT_LOG_LEVEL=INFO

# Path to the cortex CLI binary. The Dockerfile sets this; for local dev the
# SDK finds `cortex` on PATH automatically, so you can usually leave it unset.
# CORTEX_CODE_CLI_PATH=/root/.local/bin/cortex
